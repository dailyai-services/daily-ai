# ==============================================================================
# DAILY AI - ZERO/NEAR-ZERO OPERATING COST CONFIGURATION
# ==============================================================================
# IMPORTANT:
# This project enforces a strict FREE-TIER ONLY policy.
# Do NOT enable billing or use paid API keys.
# If no API key is provided, DAILY AI uses the built-in Intelligent Mock Provider.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Which engine to use: auto | ollama | gemini | mock
# auto = local Ollama first, then Gemini (only if a key is set), then the
# built-in offline engine. Nothing paid is ever called.
AI_PROVIDER=auto

# Local Ollama (free, runs on this machine). Install from ollama.com, then:
#   ollama pull qwen2.5:7b
# Only localhost URLs are accepted, and "cloud" models are refused.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=90000

# Google Gemini API Key (FREE TIER ONLY)
# Obtain a free key from Google AI Studio (free tier quota: 15 RPM / 1M TPM / 1500 RPD)
# Leave empty to run entirely offline with mock provider
GEMINI_API_KEY=

# Model to use (must be free-tier eligible)
GEMINI_MODEL=gemini-1.5-flash

# Strict spending guard (true = block any paid or billing-required calls)
STRICT_ZERO_COST_MODE=true

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
